{
  "name": "@gwi/github-webhook",
  "version": "0.10.0",
  "description": "GitHub Webhook Handler for Git With Intent - triggers workflows on PR events",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gwi/core": "*",
    "@gwi/engine": "*",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "14.3.0",
    "helmet": "^8.3.0",
    "vite": "8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
