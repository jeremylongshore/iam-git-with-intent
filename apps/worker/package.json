{
  "name": "@gwi/worker",
  "version": "0.10.0",
  "description": "Git With Intent - Background Worker Service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.1.0",
    "@gwi/core": "*",
    "@gwi/engine": "*",
    "@octokit/auth-app": "^8.3.1",
    "express": "^5.2.1",
    "firebase-admin": "14.4.0",
    "helmet": "^8.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
