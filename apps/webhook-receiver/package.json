{
  "name": "@gwi/webhook-receiver",
  "version": "0.10.0",
  "description": "Multi-source webhook receiver for Git With Intent connector framework (GitHub, GitLab, Linear, Slack)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.0.1",
    "@gwi/connectors": "*",
    "@gwi/core": "*",
    "express": "^5.2.1",
    "firebase-admin": "14.3.0",
    "helmet": "^8.3.0",
    "vite": "8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
