{
  "name": "@gwi/gateway",
  "version": "0.10.0",
  "description": "A2A Gateway for Git With Intent - R3 compliant proxy to Agent Engine",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^7.2.0",
    "@google-cloud/storage": "^7.7.0",
    "@gwi/core": "*",
    "@gwi/engine": "*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "firebase-admin": "14.3.0",
    "helmet": "^8.3.0",
    "js-yaml": "^5.4.1",
    "vite": "8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
