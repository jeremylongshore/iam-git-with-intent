{
  "name": "@gwi/cli",
  "version": "0.10.0",
  "description": "CLI for Git With Intent - AI-powered DevOps automation",
  "type": "module",
  "bin": {
    "gwi": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gwi/agents": "*",
    "@gwi/core": "*",
    "@gwi/engine": "*",
    "@gwi/integrations": "*",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "firebase-admin": "14.4.0",
    "ora": "^9.4.1",
    "vite": "8.3.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
