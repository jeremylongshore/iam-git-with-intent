{
  "name": "@gwi/integrations",
  "version": "0.10.0",
  "description": "External integrations for Git With Intent: GitHub, GitLab, Slack",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "import": "./dist/github/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.1.0",
    "@gwi/core": "*",
    "firebase-admin": "14.4.0",
    "octokit": "^5.0.5",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
