{
  "name": "@gwi/core",
  "version": "0.10.0",
  "description": "Core utilities for Git With Intent: Storage, A2A, Models",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./run-bundle": {
      "types": "./dist/run-bundle/index.d.ts",
      "import": "./dist/run-bundle/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:secrets:smoke": "vitest run src/secrets/__tests__/smoke.test.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@google-cloud/secret-manager": "^7.1.0",
    "@google-cloud/storage": "^8.2.0",
    "@google-cloud/vertexai": "^1.10.0",
    "@google/generative-ai": "^0.21.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-prometheus": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "firebase-admin": "^14.4.0",
    "openai": "^7.18.0",
    "stripe": "^22.6.2",
    "vite": "8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
