{
  "name": "@gwi/forecasting",
  "version": "0.10.0",
  "description": "Time series forecasting for Git With Intent using TimeGPT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./collectors": {
      "types": "./dist/collectors/index.d.ts",
      "import": "./dist/collectors/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@gwi/core": "*",
    "firebase-admin": "14.3.0",
    "vite": "8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
